<?xml version="1.0" encoding="utf-8"?>
<!--
    phonecard —— 手机桌面卡片（ColorOS/通用 Android 桌面小组件）
    每张卡片 = 1 个 receiver（继承 card.BaseCard）+ 1 个 *Card.java + 1 个 layout + 1 个 info xml
    新增卡片时照抄下面 <receiver> 块并改 3 个名字即可。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zhuweiyou.phonecard">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- 时钟卡片要"准点翻分钟"，Android 12+ 需要精确闹钟权限（用户可在系统设置里授予） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+：时钟类应用专用，安装即授予（无需用户手动开"闹钟和提醒"） -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 11+ 包可见性：让卡片能解析到系统日历 / 时钟 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 卡片模块 01：白色时钟 ========== -->
        <receiver
            android:name=".card.WhiteClockCard"
            android:exported="true"
            android:label="@string/card_white_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 每分钟自刷新用的私有 action，必须与本类 ACTION_TICK 一致 -->
                <action android:name="com.zhuweiyou.phonecard.action.WHITE_CLOCK_TICK" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/card_white_clock_info" />
        </receiver>
        <!-- ========== /卡片模块 01 ========== -->

        <!--
        卡片模块 02（示例，新增时取消注释并按需改名）：
        <receiver android:name=".card.DemoCard" android:exported="true"
            android:label="@string/card_demo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.zhuweiyou.phonecard.action.DEMO_TICK" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/card_demo_info" />
        </receiver>
        -->
    </application>
</manifest>
