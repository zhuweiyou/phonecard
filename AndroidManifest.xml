<?xml version="1.0" encoding="utf-8"?>
<!--
    phonecard —— 手机桌面卡片（ColorOS/通用 Android 桌面小组件）
    每张卡片 = 1 个 receiver（AppWidgetProvider）+ 1 个 *Card.java + 1 个 layout + 1 个 info xml
    新增卡片时照抄下面 <receiver> 块并改 3 个名字即可（卡片为自包含实现，无基类）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zhuweiyou.phonecard">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- 无周期刷新：时间用 TextClock 自走，日期靠系统广播，不申请精确闹钟权限。 -->

    <!-- Android 11+ 包可见性：让卡片能解析到系统日历 / 时钟 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 卡片模块 01：白色时钟 ========== -->
        <receiver
            android:name=".card.WhiteClockCard"
            android:exported="true"
            android:label="@string/card_white_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 时间/日期都由 TextClock 自走，无需系统广播；仅升级后重刷一次让新布局生效 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/card_white_clock_info" />
        </receiver>
        <!-- ========== /卡片模块 01 ========== -->

        <!--
        卡片模块 02（示例，新增时取消注释并按需改名）：
        <receiver android:name=".card.DemoCard" android:exported="true"
            android:label="@string/card_demo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/card_demo_info" />
        </receiver>
        -->
    </application>
</manifest>
